# Replace the public host and TLS paths. The entire member root routes to the gateway.
server {
    listen 443 ssl;
    server_name union.example.org;
    ssl_certificate /etc/letsencrypt/live/union.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/union.example.org/privkey.pem;
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:8267;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        # Never log authentication bodies, Authorization, cookies or query strings.
        access_log off;
    }
}
